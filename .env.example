# Copy to .env locally. Never commit a real key.
OPENAI_API_KEY=
OPENAI_ANALYST_MODEL=gpt-5.4-mini
OPENAI_WRITER_MODEL=gpt-5.4
OPENAI_REVIEWER_MODEL=gpt-5.4

# openai is the normal runtime. mock is explicit, deterministic, and not AI.
LORE_PROVIDER=openai
LORE_DB_PATH=runtime/loreforge.db

# Optional. Only runs explicitly opted into public-input tracing are sent.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=loreforge-public-evaluation
